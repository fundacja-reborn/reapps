# =====================================================
# REBORN TASK - APPLICATION SPECIFIC CONFIGURATION
# =====================================================
# 
# This file contains environment variables specific to
# the Reborn Task application.
# 
# Common variables (DATABASE_URL, JWT_SECRET, etc.) are
# loaded from the root .env file via vite.config.ts.
# =====================================================

# App Configuration
VITE_APP_NAME="Reborn Task"
VITE_APP_DESCRIPTION="Secure task management with E2E encryption"

# PWA Configuration
VITE_APP_SHORT_NAME="Tasks"

# Feature Flags
VITE_ENABLE_RECURRING_TASKS=true
VITE_ENABLE_SUBTASKS=true
VITE_ENABLE_TASK_ATTACHMENTS=false
VITE_ENABLE_TASK_COMMENTS=false

# UI Configuration
VITE_DEFAULT_TASK_VIEW="list" # list | calendar | kanban
VITE_TASKS_PER_PAGE=20

# Public URL (for PWA manifest, meta tags, etc.)
VITE_PUBLIC_URL="http://localhost:4200"
