{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"checkJs": false,
		"skipLibCheck": true
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"./vite.config.ts",
		"./src/**/*.js",
		"./src/**/*.ts",
		"./src/**/*.svelte",
		"./tests/**/*.js",
		"./tests/**/*.ts",
		"./tests/**/*.svelte"
	],
	"exclude": [
		"node_modules",
		"**/node_modules/**",
		"../../packages/*/dist/**",
		"../../packages/ui/dist/**"
	]
}
