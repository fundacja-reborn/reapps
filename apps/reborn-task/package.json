{
  "name": "reborn-task",
  "version": "0.6.5",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:quick": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "sync": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json --threshold warning",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.check.json --watch --threshold warning",
    "lint": "eslint src",
    "format": "prettier --check src",
    "clean": "rm -rf .svelte-kit node_modules dist build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@sveltejs/adapter-auto": "6.1.1",
    "@sveltejs/kit": "2.57.1",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "24.12.2",
    "@types/qrcode": "1.5.6",
    "@types/web-push": "3.6.4",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.17.0",
    "globals": "16.5.0",
    "otpauth": "9.5.0",
    "postcss": "8.5.10",
    "postcss-import": "16.1.1",
    "prettier": "3.8.1",
    "prettier-plugin-svelte": "3.5.1",
    "qrcode": "1.5.4",
    "svelte": "5.55.1",
    "svelte-check": "4.4.6",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0",
    "vite": "8.0.8",
    "vitest": "4.1.4"
  },
  "type": "module",
  "dependencies": {
    "@lucide/svelte": "0.515.0",
    "@reborn/api-client": "workspace:*",
    "@reborn/auth": "workspace:*",
    "@reborn/crypto": "workspace:*",
    "@reborn/database": "workspace:*",
    "@reborn/i18n": "workspace:*",
    "@reborn/storage": "workspace:*",
    "@reborn/types": "workspace:*",
    "@reborn/ui": "workspace:*",
    "@reborn/utils": "workspace:*",
    "rrule": "2.8.1",
    "server-only": "0.0.1",
    "svelte-dnd-action": "0.9.69",
    "web-push": "3.6.7"
  }
}
