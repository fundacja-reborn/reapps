    "@types/cookie": "0.6.0",
    "@types/node": "24.12.4",
    "@types/qrcode": "1.5.6",
    "@types/web-push": "3.6.4",
    "autoprefixer": "10.5.0",
    "cookie": "0.7.2",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.17.1",
    "globals": "17.6.0",
    "otpauth": "9.5.1",
    "postcss": "8.5.15",
