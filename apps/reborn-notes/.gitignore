node_modules
/build
/build-native
/.svelte-kit
/package

# Generated from app.html by scripts/gen-native-template.mjs on every build-native*.
/src/app.native.html

# Capacitor native projects (generated by `npx cap add <platform>`).
# `android/` (Faza 3b) and `ios/` (Faza 4) are tracked: we customise native
# config (deep-link intent-filters, entitlements) and head toward store
# releases, so they are the durable, reviewable source of truth. Their nested
# `.gitignore` files (Capacitor's standard templates) keep build artifacts,
# `local.properties`, DerivedData, copied web assets and generated config out.
# IDE state is excluded here. Keystore/signing material arrives in Faza 5 -
# add `*.jks`/`*.keystore` ignores then.
/android/.idea/
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
