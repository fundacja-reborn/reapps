# =====================================================
# REBORN NOTES - APPLICATION SPECIFIC CONFIGURATION
# =====================================================
# 
# This file contains environment variables specific to
# the Reborn Notes application.
# 
# Common variables (DATABASE_URL, JWT_SECRET, etc.) are
# loaded from the root .env file via vite.config.ts.
# =====================================================

# App Configuration
VITE_APP_NAME="Reborn Notes"
VITE_APP_DESCRIPTION="Secure note-taking with E2E encryption"

# PWA Configuration
VITE_APP_SHORT_NAME="Notes"

# Feature Flags
VITE_ENABLE_MARKDOWN_PREVIEW=true
VITE_ENABLE_FOLDERS=true
VITE_ENABLE_TAGS=true
VITE_ENABLE_NOTE_SHARING=false
VITE_ENABLE_COLLABORATIVE_EDITING=false

# UI Configuration
VITE_DEFAULT_NOTE_VIEW="grid" # grid | list
VITE_NOTES_PER_PAGE=20
VITE_ENABLE_DARK_MODE=true

# Editor Configuration
VITE_EDITOR_AUTO_SAVE_DELAY=5000 # milliseconds
VITE_EDITOR_MAX_FILE_SIZE=10485760 # 10MB in bytes

# Public URL (for PWA manifest, meta tags, etc.)
VITE_PUBLIC_URL="http://localhost:4201"
