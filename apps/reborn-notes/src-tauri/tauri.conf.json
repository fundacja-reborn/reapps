{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "re-notes-spike",
  "identifier": "eu.reapps.notes.spike",
  "build": {
    "frontendDist": "../build-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "re/notes",
        "width": 1280,
        "height": 832,
        "minWidth": 360,
        "minHeight": 480,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "backgroundColor": "#FFD43B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
