{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "re-notes-dev",
  "version": "1.0.0",
  "identifier": "eu.reapps.notes.dev",
  "build": {
    "frontendDist": "../build-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "re/notes",
        "width": 1280,
        "height": 832,
        "minWidth": 360,
        "minHeight": 480,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default", "http-local"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "Copyright © 2025-2026 Fundacja Reborn",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "bundleVersion": "3",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "macos/InfoPlist.dev.strings",
        "Resources/pl.lproj/InfoPlist.strings": "macos/InfoPlist.dev.strings",
        "Resources/de.lproj/InfoPlist.strings": "macos/InfoPlist.dev.strings",
        "Resources/es.lproj/InfoPlist.strings": "macos/InfoPlist.dev.strings",
        "Resources/fr.lproj/InfoPlist.strings": "macos/InfoPlist.dev.strings",
        "Resources/ar.lproj/InfoPlist.strings": "macos/InfoPlist.dev.strings"
      }
    }
  }
}
