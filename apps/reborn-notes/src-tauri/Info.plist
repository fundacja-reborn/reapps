<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged by the Tauri bundler into every macOS build of the shell. The
	     store build overrides the names in macos/Info.appstore.plist. -->
	<!-- "re/notes" cannot be the product name (Tauri refuses a "/" there, it
	     names the .app file), so the names the user sees are set here: the
	     menu bar, the Dock, the notification and keychain prompts. -->
	<key>CFBundleName</key>
	<string>re/notes dev</string>
	<key>CFBundleDisplayName</key>
	<string>re/notes dev</string>
	<!-- Standard encryption only (Web Crypto in WebKit, TLS), the same answer
	     as the iOS shell: no export compliance documents per upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
