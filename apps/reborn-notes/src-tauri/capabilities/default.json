{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The page in the main window: the shell's own commands it calls, event listening for the app menu, and HTTP to the API origin only. Nothing else from core (no menu, window, webview, app or path API). A store build must list its own API origin here and nothing else. Kept in step with build.rs and lib.rs by src/lib/utils/desktop-capabilities.spec.ts.",
  "windows": ["main"],
  "permissions": [
    "allow-secure-storage-get",
    "allow-secure-storage-set",
    "allow-secure-storage-remove",
    "allow-folder-fs-pick-directory",
    "allow-folder-fs-list-files",
    "allow-folder-fs-read-file",
    "allow-folder-fs-is-same-directory",
    "allow-folder-fs-write-file",
    "allow-folder-fs-delete-file",
    "allow-folder-fs-release-directory",
    "allow-file-export-save",
    "allow-app-lock-status",
    "allow-app-lock-authenticate",
    "allow-app-info",
    "allow-desktop-menu-localize",
    "allow-backup-reminder-status",
    "allow-backup-reminder-request-permission",
    "allow-backup-reminder-schedule",
    "allow-backup-reminder-cancel",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://localhost/*" }]
    }
  ]
}
