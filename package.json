    "@nx/vite": "21.2.0",
    "@nx/web": "21.2.0",
    "@nx/workspace": "21.2.0",
    "@sveltejs/adapter-auto": "6.1.1",
    "@sveltejs/kit": "2.57.1",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@swc-node/register": "1.10.10",
    "@swc/core": "1.12.14",
    "@swc/helpers": "0.5.21",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "4.1.4",
    "@vitest/ui": "4.1.4",
    "dotenv-cli": "8.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.4.2",
    "jsdom": "26.1.0",
    "jsonc-eslint-parser": "2.4.2",
    "knip": "5.88.1",
    "nx": "21.2.0",
