{
  "name": "@reborn-apps/source",
  "version": "0.6.5",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "clean": "chmod +x ./scripts/clean-all.sh && ./scripts/clean-all.sh",
    "clean:install": "pnpm clean && pnpm install && pnpm nx reset",
    "build": "nx run-many --target=build --all",
    "build:crypto": "nx build @reborn/crypto",
    "dev": "nx run-many --target=dev --all",
    "test": "nx run-many --target=test --all",
    "db:migrate": "cd packages/database && pnpm db:migrate",
    "db:generate": "cd packages/database && pnpm db:generate",
    "db:studio": "cd packages/database && pnpm db:studio",
    "db:seed": "cd packages/database && pnpm db:seed",
    "db:setup": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "knip": "knip",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release:patch": "node scripts/release.mjs --specifier=patch",
    "release:minor": "node scripts/release.mjs --specifier=minor",
    "release:major": "node scripts/release.mjs --specifier=major"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@nx/eslint": "21.2.0",
    "@nx/eslint-plugin": "21.2.0",
