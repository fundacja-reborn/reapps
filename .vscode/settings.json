{
  // Disable HTML validation for SvelteKit template files
  "html.validate.scripts": false,
  "html.validate.styles": false,
  "html.validate.templates": false,
  "html.customData": ["./apps/reborn-task/html-data.json"],

  // File-specific settings
  "[html]": {
    "editor.formatOnSave": false
  },

  // File associations
  "files.associations": {
    "app.html": "html"
  },

  // Exclude app.html from certain validations
  "files.exclude": {
    "**/node_modules": true,
    "**/.svelte-kit": true,
    "**/dist": true,
    "**/.nx": true
  },

  // Microsoft Edge Tools - disable warnings for app.html
  "microsoft-edge-tools.webhint.enableHints": {
    "no-inline-styles": false
  },

  // HTML hint configuration
  "htmlhint.options": {
    "inline-style-disabled": false,
    "title-require": false
  },

  // Disable specific axe rules for template files
  "axe-linter.disable": ["document-title", "html-lang-valid"]
}
