# Używaj pnpm jako package manager
package-manager-strict=false

# Automatycznie akceptuj skrypty build dla trusted packages
auto-install-peers=true
strict-peer-dependencies=false

# Pozwól na instalację deprecated packages (czasem potrzebne dla starszych dependencies)
legacy-peer-deps=true

# Hoisting dla Nx dependencies
public-hoist-pattern[]=*nx*
public-hoist-pattern[]=*@nx/*
public-hoist-pattern[]=*minimatch*
public-hoist-pattern[]=*@swc/*
shamefully-hoist=true

# Enable patches
enable-pre-post-scripts=true
