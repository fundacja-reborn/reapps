{
  "name": "@reborn/ui",
  "version": "0.1.3",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.stories.*"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "svelte": "./src/utils/index.ts"
    },
    "./components/dialog": {
      "types": "./src/components/dialog/index.ts",
      "svelte": "./src/components/dialog/index.ts"
    },
    "./components/dropdown-menu": {
      "types": "./src/components/dropdown-menu/index.ts",
      "svelte": "./src/components/dropdown-menu/index.ts"
    },
    "./styles/global.css": {
      "import": "./src/styles/global.css"
    },
    "./sidebar": {
      "types": "./src/components/sidebar/index.ts",
      "svelte": "./src/components/sidebar/index.ts"
    },
    "./components/tooltip": {
      "types": "./src/components/tooltip/index.ts",
      "svelte": "./src/components/tooltip/index.ts"
    },
    "./components/avatar": {
      "types": "./src/components/avatar/index.ts",
      "svelte": "./src/components/avatar/index.ts"
    },
    "./components/separator": {
      "types": "./src/components/separator/index.ts",
      "svelte": "./src/components/separator/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "demo": "cd demo && pnpm install && vite",
    "demo:build": "cd demo && vite build"
  },
  "peerDependencies": {
    "svelte": "5.0.0",
    "tailwindcss": "4.1.0"
  },
  "dependencies": {
    "@internationalized/date": "3.12.0",
    "@lucide/svelte": "0.515.0",
    "@reborn/i18n": "workspace:*",
    "bits-ui": "2.16.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "mode-watcher": "1.1.0",
    "svelte-sonner": "1.1.0",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@reborn/types": "workspace:*",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-links": "9.1.20",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/blocks": "8.6.14",
    "@storybook/svelte": "9.1.20",
    "@storybook/svelte-vite": "9.1.20",
    "@storybook/test": "8.6.15",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "24.12.2",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.4",
    "postcss": "8.5.8",
    "storybook": "9.1.20",
    "svelte": "5.55.1",
    "svelte-check": "4.4.6",
    "tailwind-variants": "1.0.0",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.8",
    "vitest": "4.1.4"
  }
}
