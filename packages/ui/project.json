{
  "name": "@reborn/ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ui/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "packages/ui",
        "command": "tsc --build"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/ui",
        "command": "tsc --build --watch"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/ui",
        "command": "tsc --noEmit"
      }
    },
    "demo": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/ui",
        "command": "pnpm demo:with-build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "cwd": "packages/ui",
        "command": "vitest run"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/ui/**/*.{ts,svelte,js}"]
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/ui",
        "command": "storybook dev -p 6006"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/storybook-static"],
      "options": {
        "cwd": "packages/ui",
        "command": "storybook build"
      }
    }
  }
}
