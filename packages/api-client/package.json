{
  "name": "@reborn/api-client",
  "version": "0.14.2",
  "description": "Universal API client for Reborn apps with E2E encryption support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:run": "vitest run",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@reborn/auth": "workspace:*",
    "@reborn/crypto": "workspace:*",
    "@reborn/types": "workspace:*",
    "@reborn/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@vitest/ui": "4.1.5",
    "eslint": "10.2.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "@reborn/auth": "workspace:*",
    "@reborn/crypto": "workspace:*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
