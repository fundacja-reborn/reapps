{
  "name": "@reborn/storage",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/storage/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project storage --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm build",
        "cwd": "packages/storage"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": ["{workspaceRoot}/coverage/packages/storage"],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../coverage/packages/storage",
        "configFile": "packages/storage/vitest.config.ts"
      }
    }
  }
}
