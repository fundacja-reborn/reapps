{
  "name": "@reborn/i18n",
  "version": "0.37.1",
  "private": true,
  "type": "module",
  "description": "Internationalization package for Reborn apps",
  "keywords": [
    "i18n",
    "translations",
    "internationalization",
    "svelte"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types && tsup && pnpm copy-translations",
    "build:types": "tsc -p tsconfig.build.json",
    "copy-translations": "mkdir -p dist && cp -r src/translations dist/ && mkdir -p dist/release-notes && cp -r src/release-notes/text dist/release-notes/ && cp src/release-notes/manifest.json dist/release-notes/",
    "dev": "tsup --watch",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "test": "vitest run",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "svelte-i18n": "4.0.1"
  },
  "devDependencies": {
    "@reborn/types": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/node": "24.12.4",
    "svelte": "5.56.3",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "svelte": "5.56.3"
  }
}
