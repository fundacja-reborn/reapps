{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "declarationDir": "./dist",
    "declaration": true,
    "module": "ESNext",
    "lib": ["ES2022", "dom"],
    "target": "ES2022",
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
  "references": [
    { "path": "../types" },
    { "path": "../utils" }
  ]
}