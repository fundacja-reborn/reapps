# =====================================================
# MONOREPO SHARED ENVIRONMENT CONFIGURATION
# =====================================================
# 
# This file contains SHARED environment variables used by:
# - Backend/API routes
# - Database connections
# - Security keys
# - External services
# 
# APPLICATION-SPECIFIC variables (like VITE_APP_NAME)
# should be defined in each app's local .env file:
# - apps/reborn-task/.env
# - apps/reborn-notes/.env
# =====================================================

NODE_ENV=development

# Database (local PostgreSQL)
# For Docker: this value is overridden in docker-compose.yml (host: db instead of localhost)
# For production: same Docker setup on Hetzner Cloud VPS
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reborn?sslmode=disable"

DB_HOST=localhost
DB_NAME=reborn
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Server
PORT=4200

# API
# API jest częścią SvelteKit, nie potrzebuje osobnego URL
# API_BASE_URL="/api"

# Logging
# Log level for server-side logger. Allowed: DEBUG, INFO, WARN, ERROR
# Defaults to WARN in production (NODE_ENV=production), DEBUG otherwise
# LOG_LEVEL=DEBUG

# Security
JWT_SECRET="your-secret-key-here"
REFRESH_TOKEN_SECRET="your-refresh-secret-key-here"
# JWT_SECRET_PREVIOUS — set to the old secret during key rotation (grace period: max 7 days)
# See docs/security/jwt-secret-rotation.md for the full procedure
# JWT_SECRET_PREVIOUS=""

# Trusted reverse proxies (comma-separated IPs)
# When set, X-Forwarded-For is trusted only from these IPs + private ranges.
# Docker internal IPs (172.x) are trusted implicitly.
# Example for production: TRUSTED_PROXIES="172.18.0.2"
TRUSTED_PROXIES=""

# Session
SESSION_SECRET="your-session-secret-here"

# Web Push
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

# Recovery System
RECOVERY_KEY_SECRET="your-recovery-key-secret"

# Feature Flags
ENABLE_2FA=true
ENABLE_PUSH_NOTIFICATIONS=true

# =====================================================
# DEPLOYMENT: Same-origin PWA paths
# =====================================================
# When both apps are served from the same domain (same-origin SSO):
#
#   nginx: /task → reborn-task, /notes → reborn-notes
#
# Set the following in each app's production .env:
#   apps/reborn-task/.env.production:  PUBLIC_BASE_PATH=/task
#   apps/reborn-notes/.env.production: PUBLIC_BASE_PATH=/notes
#
# Cross-app links (update for production):
#   apps/reborn-task/.env.production:  PUBLIC_NOTES_URL=/notes
#   apps/reborn-notes/.env.production: PUBLIC_TASK_URL=/task
#
# Leave empty in development (apps run at root on different ports):
PUBLIC_BASE_PATH=

# Public website URL (Astro site — landing, blog, legal pages):
# Production: PUBLIC_SITE_URL=https://reapps.eu
PUBLIC_SITE_URL=http://localhost:4300

# Storage Quota
# Per-user storage limit in bytes (notes + version history).
# Default: 104857600 (100 MB). Set to 0 to disable quota checks.
USER_STORAGE_LIMIT_BYTES=104857600

# =====================================================
# DO NOT PUT APP-SPECIFIC VARIABLES HERE!
# =====================================================
# Variables like:
# - VITE_APP_NAME
# - VITE_APP_VERSION
# - VITE_THEME_COLOR
# - App-specific feature flags
#
# Should go in the app's local .env file instead!
# =====================================================
